rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && prof().active == true;
    }
    function admin() { return active() && prof().role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() ||
        (request.auth.uid == uid
         && request.auth.token.email == 'admin@skj-bill.local'
         && request.resource.data.role == 'admin'
         && request.resource.data.active == true);
      allow update, delete: if admin();
    }

    match /sales/{id} {
      allow read: if active() && (admin() || resource.data.by == request.auth.uid);
      allow create: if active() && request.resource.data.by == request.auth.uid;
      allow update: if active() && (admin() || resource.data.by == request.auth.uid);
      allow delete: if admin();
    }

    match /config/{doc} {
      allow read: if active();
      allow write: if admin();
    }

    // Live gold rate calibration (sabko dikhta hai, sirf Admin badal sakta hai)
    match /public/{doc} {
      allow get: if true;
      allow list: if false;
      allow write: if admin();
    }

    // Bill verification (QR): koi bhi code se ek bill dekh sakta hai, list nahi
    match /verify/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if active();
      allow update: if active() && (admin() || resource.data.by == prof().id);
      allow delete: if admin();
    }
  }
}
